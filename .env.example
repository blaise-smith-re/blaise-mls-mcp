# blaise-mls-mcp environment reference (see docs/ENVIRONMENT.md for full details)
# Copy to .env for local development. NEVER commit a real token.

# Provider selection: "fixture" (deterministic offline dataset) or "mlsgrid" (live MLS Grid API).
# Defaults to fixture. "mlsgrid" requires MLSGRID_TOKEN and remains uncertified until the
# live Matrix reconciliation certification passes (docs/CERTIFICATION_RUNBOOK.md).
MLS_PROVIDER=fixture

# --- MLS Grid (only required when MLS_PROVIDER=mlsgrid) ---
MLSGRID_API_BASE=https://api.mlsgrid.com/v2
MLSGRID_TOKEN=
MLSGRID_ORIGINATING_SYSTEM=northstar

# Provisional, documentation-derived tuning. Confirm against live metadata before changing.
MLSGRID_TIMEOUT_MS=30000
MLSGRID_MIN_REQUEST_INTERVAL_MS=600
MLSGRID_MAX_RETRIES=3
MLSGRID_PAGE_SIZE=1000
MLSGRID_MAX_PAGES_PER_QUERY=5
# Comma-separated override of the server-side filterable field allowlist once live
# $metadata confirms actual searchable fields. Leave empty for the conservative default.
MLSGRID_SERVER_FILTER_FIELDS=
# Private/agent remarks are mapped ONLY when the licensed feed legitimately exposes them
# AND this flag is explicitly enabled. Default false.
MLSGRID_EXPOSE_PRIVATE_REMARKS=false

# --- AI Use Addendum controls (see docs/AI_USE_ADDENDUM_REVIEW.md) ---
# Kill switch (Addendum §3.c). DEFAULT OFF. While false, no MLS tool is registered
# and no MLS Grid request is made, even with a valid token configured.
MLS_AI_ACCESS_ENABLED=false

# Declared Authorized AI Use (§1.e). Comma-separated. Valid values:
#   permitted_marketing_use        — §1.h, Marketing Content for the Participant's OWN
#                                    listings or business (§1.g)
#   permitted_search_response_use  — §1.i, REQUIRES an idx or vow license class below
#   written_authorization          — requires MLS_AI_WRITTEN_APPROVAL_REFERENCE
# "back_office" is NOT a valid basis: Back Office data access is not AI permission.
MLS_AI_AUTHORIZED_USE_BASES=

# Executed data-license class(es): idx, vow, back_office. Comma-separated.
# §1.i: permitted_search_response_use requires idx or vow; back_office does not carry it.
MLS_AI_LICENSE_CLASSES=

# Identifies the written MLS GRID / MLS authorization relied upon, when applicable.
MLS_AI_WRITTEN_APPROVAL_REFERENCE=

# Per-tool allowlist (§2). Empty authorizes NOTHING. The server will not infer that a
# tool falls within a permitted use — each must be affirmatively authorized.
# Valid: get_listing, search_listings, get_listing_history, get_comparables,
#        market_stats, get_market_snapshot, lookup_member_or_office, get_open_houses
MLS_AI_AUTHORIZED_TOOLS=

# Participant named in attribution (§3.d).
MLS_PARTICIPANT_NAME=

# --- General ---
MLS_DEFAULT_TIMEZONE=America/Chicago
MLS_MAX_RECORDS_PER_QUERY=2500

# --- Claude -> MCP authentication boundary (server-side MLS Grid token never leaves the server) ---
# Bearer token required on the /mcp endpoint when set. Strongly recommended in production.
MCP_AUTH_TOKEN=

# --- HTTP server ---
PORT=3000
LOG_LEVEL=info
